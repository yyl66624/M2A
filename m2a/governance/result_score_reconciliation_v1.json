 "known_static_gaps": {
  "p17_gate.py": {
   "kind": "loop_nested",
   "why": "G1 的锚定比较写在 `for` 里（两条口径各一次），静态 6 个站点、执行 7 条判定。§42 的 169 是**站点数**，门控打印的是**判定条数**：本表把两个数放在一起，免得「169」被当成执行量引用。"
  },
  "l01_gate.py": {
   "kind": "other_harness",
   "why": "文献轮的 `l01_gate.py` 不使用 `check()`——它自带断言并打印 `7/7 checks passed`，所以 §42 的静态普查对它记 0。这是「两数不可比」，不是缺失：§42 的 §4 第三条已声明本库对不使用 `check()` 的门控**沉默**。"
  },
  "l02_gate.py": {
   "kind": "other_harness",
   "why": "L-02 的门控与 `l01_gate.py` 同一族：它用自己的 `report()` 记录判定并把条数钉在 `RULES` 常量上，`check()` 站点为 0，静态普查与打印的 `n/n` 不可比。它与打印数的唯一区别是判定条数由登记表决定，而不是由出现过几次 `check()` 决定。"
  },
  "p28_gate.py": {
   "kind": "other_harness",
   "why": "Phase XXVIII 的门控用自带的 report() 记录判定，check() 站点为 0；静态站点数与打印的 n/n 不可比。"
  },
  "p27_gate.py": {
   "kind": "other_harness",
   "why": "Phase XXVII 的门控用自带的 report() 记录判定，check() 站点为 0；静态站点数与打印的 n/n 不可比。"
  },
  "p26_gate.py": {
   "kind": "other_harness",
   "why": "Phase XXVI 的门控用自带的 report() 记录判定，check() 站点为 0；静态站点数与打印的 n/n 不可比。"
  },
  "p25_gate.py": {
   "kind": "other_harness",
   "why": "Phase XXV 的门控用自带的 report() 记录判定，check() 站点为 0；静态站点数与打印的 n/n 不可比。"
  },
  "l03_gate.py": {
   "kind": "other_harness",
   "why": "L-03 的门控与 `l01_gate.py`/`l02_gate.py` 同一族：它用自己的 `report()` 记录判定，`check()` 站点为 0；full 模式打印 20/20，pre 模式打印 13/13，静态站点数与两者都不可比。"
  }
 },
